{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Public catalog read by the site and by the in-game Mod Hub. Text is untrusted data: keep it plain and short.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 2},
    "mods": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/mod"}}
  },
  "required": ["schema_version", "mods"],
  "additionalProperties": false,
  "$defs": {
    "short": {"type": "string", "minLength": 1, "maxLength": 80},
    "long": {"type": "string", "minLength": 1, "maxLength": 400},
    "lines": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d+\\.\\d+(?:\\.\\d+)*$"}},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$", "maxLength": 40},
    "text": {
      "type": "object",
      "properties": {
        "label": {"$ref": "#/$defs/short"},
        "alt": {"$ref": "#/$defs/long"},
        "description": {"$ref": "#/$defs/long"},
        "compatibility": {"$ref": "#/$defs/short"},
        "requirements": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/long"}},
        "installation": {"type": "string", "minLength": 1, "maxLength": 600}
      },
      "required": ["label", "alt", "description", "compatibility", "requirements", "installation"],
      "additionalProperties": false
    },
    "release": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "version": {"$ref": "#/$defs/version"},
            "published_at": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
            "download_url": {"type": "string", "minLength": 1, "maxLength": 400},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "release_url": {"type": "string", "minLength": 1, "maxLength": 400}
          },
          "required": ["version", "published_at", "download_url", "sha256", "release_url"],
          "additionalProperties": false
        }
      ]
    },
    "mod": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
        "kind": {"enum": ["plugin", "mod"]},
        "added": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "category": {"enum": ["realismo", "visual", "clima", "carretas"]},
        "games": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ets2", "ats"]}},
        "image": {"type": "string", "pattern": "^assets/[a-z0-9-]+\\.(?:jpg|png|webp)$"},
        "compatibility": {
          "description": "Game versions documented as tested (major.minor lines); read by the in-game Mod Hub.",
          "type": "object",
          "properties": {"ets2": {"$ref": "#/$defs/lines"}, "ats": {"$ref": "#/$defs/lines"}},
          "additionalProperties": false
        },
        "dll": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,60}\\.dll$"},
        "repository": {"type": "string", "pattern": "^Rhaiderr/[A-Za-z0-9._-]{1,100}$"},
        "asset": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
        "stable": {"$ref": "#/$defs/release"},
        "beta": {"$ref": "#/$defs/release"},
        "version": {"$ref": "#/$defs/version"},
        "workshop_url": {"type": "string", "pattern": "^https://steamcommunity\\.com/sharedfiles/filedetails/\\?id=\\d{1,20}$"},
        "text": {
          "type": "object",
          "properties": {"pt-BR": {"$ref": "#/$defs/text"}, "en": {"$ref": "#/$defs/text"}},
          "required": ["pt-BR", "en"],
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "added", "name", "category", "games", "compatibility", "image", "text"],
      "oneOf": [
        {"required": ["repository", "asset", "stable", "beta"], "not": {"anyOf": [{"required": ["version"]}, {"required": ["workshop_url"]}]}},
        {"required": ["version", "workshop_url"], "not": {"anyOf": [{"required": ["repository"]}, {"required": ["asset"]}]}}
      ],
      "if": {"properties": {"kind": {"const": "plugin"}}},
      "then": {"required": ["dll", "repository"]},
      "additionalProperties": false
    }
  }
}
