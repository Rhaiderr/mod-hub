{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "category": {
            "enum": [
              "realismo",
              "visual",
              "clima"
            ]
          },
          "repository": {
            "enum": [
              "Rhaiderr/ets2-tire-wear",
              "Rhaiderr/ets2-truck-dirt",
              "Rhaiderr/ets2-brbrasil-climate"
            ]
          },
          "asset": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "compatibility": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "ets2": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+(?:\\.\\d+)*$"
                }
              },
              "ats": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+(?:\\.\\d+)*$"
                }
              }
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "installation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "stable": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "published_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                  },
                  "download_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "release_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "version",
                  "published_at",
                  "download_url",
                  "sha256",
                  "release_url"
                ],
                "additionalProperties": false
              }
            ]
          },
          "beta": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "published_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                  },
                  "download_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "release_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "version",
                  "published_at",
                  "download_url",
                  "sha256",
                  "release_url"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "repository",
          "asset",
          "compatibility",
          "requirements",
          "installation",
          "stable",
          "beta"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "plugins"
  ],
  "additionalProperties": false
}
